    "components": {
        "schemas": {
            "WorkPageQueryDTO": {
                "type": "object",
                "properties": {
                    "current": {
                        "type": "integer",
                        "description": "\u9875\u7801\uff0c\u4ece 1 \u5f00\u59cb",
                        "format": "int32",
                        "example": 1,
                        "default": 1
                    },
                    "pageSize": {
                        "type": "integer",
                        "description": "\u6bcf\u9875\u6761\u6570",
                        "format": "int32",
                        "example": 10,
                        "default": 10
                    },
                    "status": {
                        "type": "string",
                        "description": "\u72b6\u6001\u7b5b\u9009\uff1adraft=\u8349\u7a3f / published=\u5df2\u53d1\u5e03\uff0c\u4e3a\u7a7a\u8868\u793a\u5168\u90e8\uff08deleted \u9ed8\u8ba4\u4e0d\u8fd4\u56de\uff09",
                        "example": "published"
                    },
                    "keyword": {
                        "type": "string",
                        "description": "\u6807\u9898\u5173\u952e\u8bcd\uff0c\u6309\u6807\u9898\u6a21\u7cca\u5339\u914d\uff1b\u4e3a\u7a7a\u8868\u793a\u4e0d\u7b5b\u9009",
                        "example": "\u65c5\u884c"
                    }
                },
                "description": "\u4f5c\u54c1\u5206\u9875\u67e5\u8be2\u8bf7\u6c42\uff08POST /api/works/page\uff09"
            },
            "PageResultWorkVO": {
                "type": "object",
                "properties": {
                    "total": {
                        "type": "integer",
                        "description": "\u603b\u8bb0\u5f55\u6570",
                        "format": "int64",
                        "example": 32
                    },
                    "records": {
                        "type": "array",
                        "description": "\u5f53\u524d\u9875\u6570\u636e\u96c6\u5408",
                        "items": {
                            "$ref": "#/components/schemas/WorkVO"
                        }
                    }
                },
                "description": "\u5206\u9875\u67e5\u8be2\u7ed3\u679c"
            },
            "ResultPageResultWorkVO": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "integer",
                        "description": "\u4e1a\u52a1\u7801\uff1a1=\u6210\u529f\uff1b\u5931\u8d25\u65f6\u4e3a\u9519\u8bef\u7801\uff08\u901a\u5e38\u4e0e HTTP \u72b6\u6001\u7801\u4e00\u81f4\uff09",
                        "format": "int32",
                        "example": 1
                    },
                    "msg": {
                        "type": "string",
                        "description": "\u63d0\u793a\u4fe1\u606f\uff1b\u6210\u529f\u65f6\u4e3a success",
                        "example": "success"
                    },
                    "data": {
                        "$ref": "#/components/schemas/PageResultWorkVO"
                    }
                },
                "description": "\u7edf\u4e00\u8fd4\u56de\u7ed3\u6784\uff1a{code, msg, data}\uff0ccode=1 \u8868\u793a\u6210\u529f\uff0c\u5176\u4f59\u4e3a\u5931\u8d25\u7801\uff08\u4e0e HTTP \u72b6\u6001\u7801\u4fdd\u6301\u4e00\u81f4\uff09"
            },
            "WorkVO": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "\u4f5c\u54c1 ID",
                        "example": "w-1a2b3c4d5e6f"
                    },
                    "title": {
                        "type": "string",
                        "description": "\u6807\u9898",
                        "example": "\u5468\u672b\u7684\u6e56\u8fb9\u65e5\u843d"
                    },
                    "coverUrl": {
                        "type": "string",
                        "description": "\u5c01\u9762\u56fe URL\uff08/uploads/... \u8def\u5f84\uff09",
                        "nullable": true,
                        "example": "/uploads/3f9c2a1b4d5e6f7a8b9c0d1e2f3a4b5c.jpg"
                    },
                    "videoUrl": {
                        "type": "string",
                        "description": "\u89c6\u9891 URL\uff08\u9884\u7559\u5b57\u6bb5\uff0c\u5f53\u524d\u53d1\u5e03\u6d41\u7a0b\u4e0d\u4f7f\u7528\uff09",
                        "nullable": true,
                        "example": "/uploads/video.mp4"
                    },
                    "contentMd": {
                        "type": "string",
                        "description": "Markdown \u5bcc\u6587\u672c\u6b63\u6587\uff0c\u5a92\u4f53\u4ee5\u5df2\u4e0a\u4f20\u7684 /uploads/... URL \u5f15\u7528",
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "description": "\u72b6\u6001\uff1adraft=\u8349\u7a3f / published=\u5df2\u53d1\u5e03 / deleted=\u5df2\u5220\u9664",
                        "example": "published"
                    },
                    "publishedAt": {
                        "type": "string",
                        "description": "\u53d1\u5e03\u65f6\u95f4\uff08ISO 8601\uff09\uff0c\u8349\u7a3f\u4e3a null",
                        "format": "date-time"
                    },
                    "createdAt": {
                        "type": "string",
                        "description": "\u521b\u5efa\u65f6\u95f4\uff08ISO 8601\uff09",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "description": "\u66f4\u65b0\u65f6\u95f4\uff08ISO 8601\uff09",
                        "format": "date-time"
                    }
                },
                "description": "\u4f5c\u54c1\u4fe1\u606f\uff08\u53d1\u5e03/\u8be6\u60c5/\u5217\u8868\u5171\u7528\uff09"
            },
            "UpdateUserDTO": {
                "type": "object",
                "properties": {
                    "nickname": {
                        "type": "string",
                        "description": "\u6635\u79f0",
                        "example": "\u62fe\u5149"
                    },
                    "bio": {
                        "type": "string",
                        "description": "\u4e2a\u4eba\u7b80\u4ecb",
                        "example": "\u8bb0\u5f55\u751f\u6d3b\u91cc\u7684\u5149"
                    },
                    "avatarUrl": {
                        "type": "string",
                        "description": "\u5934\u50cf URL\uff08\u5efa\u8bae\u4f7f\u7528\u901a\u7528\u4e0a\u4f20\u63a5\u53e3\u8fd4\u56de\u7684 /uploads/... \u8def\u5f84\uff09",
                        "example": "/uploads/3f9c2a1b4d5e6f7a8b9c0d1e2f3a4b5c.jpg"
                    },
                    "tagline": {
                        "type": "string",
                        "description": "\u4e2a\u6027\u7b7e\u540d",
                        "example": "\u4fdd\u6301\u70ed\u7231"
